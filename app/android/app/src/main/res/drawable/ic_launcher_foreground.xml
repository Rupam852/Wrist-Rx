<?xml version="1.0" encoding="utf-8"?>
<!--
    FOREGROUND — Light Mode
    Only ECG pulse + Rx symbol in BLACK
    No watch structure at all — clean minimal design
    White background (#F2F4F7) shows behind transparent areas
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!--
        ═══════════════════════════════
        ECG / HEARTBEAT PULSE LINE
        Centered at y=44, spans icon width
        Thick 4dp, rounded caps for clean look
        ═══════════════════════════════
    -->
    <path
        android:pathData="M16,44 L28,44 L34,28 L42,60 L50,44 L92,44"
        android:strokeColor="#1A1A2E"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"/>

    <!--
        ═══════════════════════════════
        Rx SYMBOL — Medical Prescription
        Centered below ECG
        Bold strokes, large size
        ═══════════════════════════════
    -->

    <!-- R — vertical stem -->
    <path
        android:pathData="M33,64 L33,84"
        android:strokeColor="#1A1A2E"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

    <!-- R — top arch / bump -->
    <path
        android:pathData="M33,64 L43,64 Q49,64 49,70 Q49,76 43,76 L33,76"
        android:strokeColor="#1A1A2E"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"/>

    <!-- R — diagonal leg -->
    <path
        android:pathData="M43,76 L50,84"
        android:strokeColor="#1A1A2E"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

    <!-- x — diagonal \ -->
    <path
        android:pathData="M57,65 L69,83"
        android:strokeColor="#1A1A2E"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

    <!-- x — diagonal / -->
    <path
        android:pathData="M69,65 L57,83"
        android:strokeColor="#1A1A2E"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

    <!-- Rx medical slash (subscript) -->
    <path
        android:pathData="M65,80 L72,84"
        android:strokeColor="#1A1A2E"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

</vector>
