<?xml version="1.0" encoding="utf-8"?>
<!--
    FOREGROUND — Wrist Rx Adaptive Icon
    Design: Watch body (white) + Dark screen fill + THICK white ECG + Bold Rx
    Screen is NOT transparent — filled with dark color so ECG always contrasts
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ═══ WATCH BAND TOP ═══ -->
    <path
        android:pathData="M42,14 L66,14 Q67.5,14 67.5,15.5 L67.5,26 L40.5,26 L40.5,15.5 Q40.5,14 42,14 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.92"/>

    <!-- ═══ WATCH BODY (outer rounded rect) ═══ -->
    <path
        android:pathData="M30,26 L78,26 Q82,26 82,30 L82,78 Q82,82 78,82 L30,82 Q26,82 26,78 L26,30 Q26,26 30,26 Z"
        android:fillColor="#FFFFFF"/>

    <!-- ═══ WATCH SCREEN (dark fill — so ECG contrasts) ═══ -->
    <path
        android:pathData="M33,33 L75,33 Q79,33 79,37 L79,71 Q79,75 75,75 L33,75 Q29,75 29,71 L29,37 Q29,33 33,33 Z"
        android:fillColor="#0A1628"/>

    <!-- ═══ WATCH BAND BOTTOM ═══ -->
    <path
        android:pathData="M40.5,82 L67.5,82 L67.5,94 Q67.5,95.5 66,95.5 L42,95.5 Q40.5,95.5 40.5,94 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.92"/>

    <!-- ═══ SIDE CROWN BUTTON ═══ -->
    <path
        android:pathData="M82,43 L84.5,43 Q85.5,43 85.5,44 L85.5,52 Q85.5,53 84.5,53 L82,53 Z"
        android:fillColor="#FFFFFF"
        android:fillAlpha="0.75"/>

    <!-- ═══ ECG PULSE LINE (WHITE, 4dp — very visible on dark screen) ═══ -->
    <!-- Simple 3-peak pulse — easy to read at small sizes -->
    <path
        android:pathData="M29,54 L37,54 L41,42 L46,66 L51,54 L79,54"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"/>

    <!-- ═══ Rx SYMBOL (white, large, bold) ═══ -->
    <!-- R — thick stroke paths -->
    <path
        android:pathData="M34,62 L34,74"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>
    <path
        android:pathData="M34,62 L40,62 Q44,62 44,65.5 Q44,69 40,69 L34,69"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"/>
    <path
        android:pathData="M40,69 L44,74"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

    <!-- x — bold X -->
    <path
        android:pathData="M49,63 L56,74"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>
    <path
        android:pathData="M56,63 L49,74"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

    <!-- Subscript slash under x (medical Rx convention) -->
    <path
        android:pathData="M54,71 L58,74"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="2"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

    <!-- ═══ SUBTLE GLOW DOTS (sparkle — small, white) ═══ -->
    <path android:pathData="M25,28 a1.5,1.5 0 1,0 3,0 a1.5,1.5 0 1,0 -3,0"
        android:fillColor="#FFFFFF" android:fillAlpha="0.45"/>
    <path android:pathData="M81,27 a1.2,1.2 0 1,0 2.4,0 a1.2,1.2 0 1,0 -2.4,0"
        android:fillColor="#FFFFFF" android:fillAlpha="0.35"/>
    <path android:pathData="M80,81 a1.3,1.3 0 1,0 2.6,0 a1.3,1.3 0 1,0 -2.6,0"
        android:fillColor="#FFFFFF" android:fillAlpha="0.30"/>

</vector>
