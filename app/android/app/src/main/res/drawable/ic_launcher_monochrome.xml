<?xml version="1.0" encoding="utf-8"?>
<!--
    MONOCHROME — Android 13+ Themed Icon
    System tints ALL white elements with wallpaper accent color.
    Black elements = dark shadow/background.

    Design rule for monochrome:
    - White = visible (tinted by system to accent color)
    - Black = dark background area (creates depth/contrast)
    - The ECG MUST be white stroke on black screen to stay visible after tinting
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Watch Band Top (white) -->
    <path
        android:pathData="M42,14 L66,14 L67.5,26 L40.5,26 Z"
        android:fillColor="#FFFFFF"/>

    <!-- Watch Body (white outer shell) -->
    <path
        android:pathData="M30,26 L78,26 Q82,26 82,30 L82,78 Q82,82 78,82 L30,82 Q26,82 26,78 L26,30 Q26,26 30,26 Z"
        android:fillColor="#FFFFFF"/>

    <!-- Watch Screen (BLACK fill — creates contrast with white ECG stroke) -->
    <path
        android:pathData="M33,33 L75,33 Q79,33 79,37 L79,71 Q79,75 75,75 L33,75 Q29,75 29,71 L29,37 Q29,33 33,33 Z"
        android:fillColor="#000000"/>

    <!-- Watch Band Bottom (white) -->
    <path
        android:pathData="M40.5,82 L67.5,82 L66,95.5 L42,95.5 Z"
        android:fillColor="#FFFFFF"/>

    <!-- Side Crown (white) -->
    <path
        android:pathData="M82,43 L85.5,43 L85.5,53 L82,53 Z"
        android:fillColor="#FFFFFF"/>

    <!--
        ECG LINE — WHITE stroke on BLACK screen
        When system tints: white → accent color (still visible on black bg)
        4dp thick — clearly visible even at small sizes
    -->
    <path
        android:pathData="M29,54 L37,54 L41,42 L46,66 L51,54 L79,54"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"/>

    <!-- Rx — R letter (white stroke on black screen) -->
    <path
        android:pathData="M34,62 L34,74"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>
    <path
        android:pathData="M34,62 L40,62 Q44,62 44,65.5 Q44,69 40,69 L34,69"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"/>
    <path
        android:pathData="M40,69 L44,74"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

    <!-- Rx — x letter -->
    <path
        android:pathData="M49,63 L56,74 M56,63 L49,74"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3.5"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

</vector>
