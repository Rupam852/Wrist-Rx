<?xml version="1.0" encoding="utf-8"?>
<!--
    ADAPTIVE ICON definition for Wrist Rx
    Requires Android 8.0+ (API 26+)

    Structure:
    - background: soft shimmering teal gradient (light) / deep navy (dark)
    - foreground: smartwatch + ECG + Rx vector
    - monochrome: single-color silhouette for Android 13+ themed icons

    Android 13+ (API 33) will automatically use the monochrome layer
    when the user enables "Themed Icons" in their wallpaper/style settings.
    The system will tint the monochrome icon with the extracted wallpaper color.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@drawable/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
