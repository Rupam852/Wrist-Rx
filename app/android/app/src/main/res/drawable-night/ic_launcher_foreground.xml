<?xml version="1.0" encoding="utf-8"?>
<!--
    FOREGROUND — Dark/Night Mode
    Same ECG pulse + Rx symbol but in WHITE
    Dark background (#0F1923) shows behind transparent areas
    Auto used when phone is in dark theme
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- ECG PULSE (WHITE on dark background) -->
    <path
        android:pathData="M16,44 L28,44 L34,28 L42,60 L50,44 L92,44"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4.5"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"/>

    <!-- R — vertical stem (WHITE) -->
    <path
        android:pathData="M33,64 L33,84"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

    <!-- R — top arch (WHITE) -->
    <path
        android:pathData="M33,64 L43,64 Q49,64 49,70 Q49,76 43,76 L33,76"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:strokeLineJoin="round"
        android:fillColor="@android:color/transparent"/>

    <!-- R — diagonal leg (WHITE) -->
    <path
        android:pathData="M43,76 L50,84"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

    <!-- x — diagonal \ (WHITE) -->
    <path
        android:pathData="M57,65 L69,83"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

    <!-- x — diagonal / (WHITE) -->
    <path
        android:pathData="M69,65 L57,83"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

    <!-- Rx medical slash (WHITE) -->
    <path
        android:pathData="M65,80 L72,84"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:fillColor="@android:color/transparent"/>

</vector>
