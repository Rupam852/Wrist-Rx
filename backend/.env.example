# Wrist Rx Backend — Environment Variables
# Copy this file to .env and fill in the values

# Server
PORT=3000
NODE_ENV=production

# MongoDB
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/wrist_rx?retryWrites=true&w=majority

# Firebase Admin SDK (Service Account JSON — paste as single line string)
# Download from Firebase Console → Project Settings → Service Accounts → Generate new private key
FIREBASE_PROJECT_ID=wrist-rx
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nYOUR_PRIVATE_KEY\n-----END PRIVATE KEY-----\n"
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@wrist-rx.iam.gserviceaccount.com

# Frontend URL (for CORS)
FRONTEND_URL=*
